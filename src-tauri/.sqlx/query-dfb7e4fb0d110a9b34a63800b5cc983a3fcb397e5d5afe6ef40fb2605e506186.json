  "query": "\n        SELECT id, name, sku, category, stock_qty, low_stock_threshold, unit, price, purchase_price,\n               (MAX(0, stock_qty) * price) as value\n        FROM products\n        WHERE is_published = 1\n        ORDER BY category, name\n        ",
